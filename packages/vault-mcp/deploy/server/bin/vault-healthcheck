#!/bin/bash
# Every 2 minutes while the box is up (vault-healthcheck.timer): ask vault-mcp's
# /healthz (app + CLI + vault). Being stopped is normal for this on-demand box,
# so this only covers "running but broken": one SNS alert once a problem has
# lasted 10 minutes, one on recovery. (A wedged box is the CloudWatch alarms' job.)
set -uo pipefail

: "${VAULT_MCP_TOKEN:?}" "${VAULT_TOPIC_ARN:?}" "${AWS_REGION:?}"
AWS=${AWS:-/snap/bin/aws}
STATE="$HOME/.local/state/vault-mcp"
mkdir -p "$STATE"

# Startup (boot, Obsidian, Sync catching up) is not a failure.
(($(cut -d. -f1 /proc/uptime) >= 900)) || exit 0

problems=()
if body=$(curl -fsS -m 30 --cacert /etc/vault-mcp/ca.pem -H "Authorization: Bearer $VAULT_MCP_TOKEN" \
  "https://localhost:${VAULT_MCP_PORT:-8443}/healthz"); then
  if [ "$(jq -r .ok <<<"$body")" != "true" ]; then
    problems+=("Obsidian app/CLI: $(jq -c '{app_running, cli, vault_found, sync}' <<<"$body")")
  fi
else
  problems+=("vault-mcp is not answering on localhost:${VAULT_MCP_PORT:-8443}")
fi

publish() {
  "$AWS" sns publish --region "$AWS_REGION" --topic-arn "$VAULT_TOPIC_ARN" \
    --subject "$1" --message "$2" >/dev/null
}

now=$(date +%s)
if ((${#problems[@]})); then
  printf '%s\n' "${problems[@]}"
  [ -f "$STATE/down_since" ] || echo "$now" >"$STATE/down_since"
  since=$(cat "$STATE/down_since")
  if ((now - since >= 600)) && [ ! -f "$STATE/alerted" ]; then
    publish "Obsidian vault server unhealthy" "Unhealthy since $(date -d "@$since"):
$(printf ' - %s\n' "${problems[@]}")

Logs: deploy.sh logs"
    touch "$STATE/alerted"
  fi
  exit 1
fi
if [ -f "$STATE/alerted" ]; then
  publish "Obsidian vault server recovered" "All checks pass again at $(date)."
fi
rm -f "$STATE/down_since" "$STATE/alerted"
echo ok
